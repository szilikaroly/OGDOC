  {
    "id": "rx.override.gate",
    "version": 1,
    "status": "active",
    "label": {
      "hu": "Megkerült kapu"
    },
    "module": "rx",
    "datatype": "text",
    "audit": true,
    "documentation": {
      "definition": {
        "hu": "Melyik kontraindikáció-kaput kerülte meg a rendelés."
      },
      "whyItMatters": {
        "hu": "A kapu NEM megkerülhetetlen — van klinikai helyzet, ahol a kockázat vállalható. De a megkerülésnek NYOMA van: melyik kapu, ki, mikor, miért. Enélkül a kapu vagy megbénítja az ellátást, vagy pipálható formalitássá válik; mindkettő rosszabb, mint a rögzített döntés."
      }
    },
    "scopedBy": {
      "dimension": "prescription",
      "roster": "rx.active"
    }
  },
