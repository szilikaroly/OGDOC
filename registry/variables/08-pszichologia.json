    "cardinality": "series",
    "documentation": {
      "definition": {
        "hu": "A kockázati tényezők együttes, KVALITATÍV megítélése."
      },
      "pitfalls": {
        "hu": "A BESOROLÁS KVALITATÍV, ÉS AZ IS MARAD. A rizikófaktorok publikált esélyhányadosai külön vizsgálatokból származnak; ezek ÖSSZESZORZÁSA nem ad érvényes együttes kockázatot, mert a faktorok nem függetlenek és a kohorszok nem összemérhetők. A rendszer ezért felsorolja a tényezőket a saját forrásukkal, és nem gyárt belőlük egyetlen számot."
      },
      "whyItMatters": {
        "hu": "A postpartum pszichózis a legveszélyesebb perinatális pszichiátriai állapot: mintegy 5% szuicid és 4% infanticid kockázattal jár, és tipikusan az első két hétben jelentkezik. Magas kockázatnál a hospitalizáció mérlegelése nem opció, hanem alapértelmezés."
      }
    }
  },
