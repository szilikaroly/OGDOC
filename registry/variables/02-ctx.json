      "en": "Gestational age"
    },
    "module": "ctx",
    "datatype": "quantity",
    "unit": "wk",
    "domain": {
      "min": 0,
      "max": 45,
      "plausible": [
        4,
        42
      ]
    },
    "derivation": {
      "kind": "computed",
      "explain": {
        "hu": "Az utolsó menstruációból számolva. IVF-nél a transzfer dátuma, egyébként a korai CRL pontosabb — a precedenciát a 02. modul kezeli."
      },
      "calc": "calc.ga.lmp"
    },
    "documentation": {
      "definition": {
        "hu": "A terhesség fennállásának ideje tizedes hétben."
      },
      "whyItMatters": {
        "hu": "A fullPIERS közvetlen bemenete, és a legtöbb szűrés időzítését ez adja."
      }
    }
  },
  {
