      {
        "code": "crl",
        "label_hu": "Korai ultrahang CRL (8–13+6. hét)"
      },
      {
        "code": "lmp",
        "label_hu": "Utolsó menstruáció"
      },
      {
        "code": "late.biometry",
        "label_hu": "Késői UH-biometria — pontatlan"
      },
      {
        "code": "unknown",
        "label_hu": "Nem meghatározható"
      }
