    "documentation": {
      "definition": {
        "hu": "Hányadik terhességi héten állították fel a diagnózist."
      },
      "whyItMatters": {
        "hu": "EZ DÖNTI EL, MI ADHATÓ. Az I. trimeszterben a kemoterápia kontraindikált (szervfejlődés), a II–III.-ban több szer adható. A gesztációs kor a kezelési terv legfontosabb bemenete — nem a stádium mellett, hanem vele egyenrangúan."
      }
    }
  },
  {
    "id": "onc.preg.placentaExamined",
    "version": 1,
    "status": "active",
    "label": {
      "hu": "Méhlepény szövettani vizsgálata"
    },
    "module": "onc",
    "datatype": "bool",
    "documentation": {
      "definition": {
        "hu": "Megtörtént-e a lepény szövettani vizsgálata a szülés után."
      },
      "whyItMatters": {
        "hu": "A LEPÉNY-ÁTTÉT ritka, de melanoma és leukaemia esetén előfordul, és a MAGZATOT is érintheti. A vizsgálat a szülés után már nem pótolható — ezért kell külön kérni, nem a rutinra bízni."
      }
    }
  },
  {
    "id": "onc.preg.sharedDecision",
    "version": 1,
    "status": "active",
    "label": {
      "hu": "Megosztott döntéshozatal dokumentálva"
    },
    "module": "onc",
    "datatype": "bool",
    "audit": true,
    "documentation": {
      "definition": {
        "hu": "Megtörtént-e és rögzült-e a beteggel közös döntéshozatal."
      },
      "pitfalls": {
        "hu": "A tájékozott beleegyezés aláírása NEM ugyanaz: az egy beavatkozásra szól. Itt a KEZELÉSI ÚT megválasztásáról van szó, több lehetőség között, és a beteg értékrendje része a döntésnek."
      },
      "whyItMatters": {
        "hu": "A MODUL ELFOGADÁSI KRITÉRIUMA. A terhesség alatti daganatkezelésben a terhesség folytatásának vagy befejezésének kérdése nem orvosi döntés: a beteg dönt, tájékozottan. A rendszer ezt nem tudja meghozni helyette — azt tudja kikényszeríteni, hogy a beszélgetés MEGTÖRTÉNJEN és nyoma legyen."
      }
    }
  },
