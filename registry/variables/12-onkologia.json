    "audit": true,
    "documentation": {
      "definition": {
        "hu": "Szóba került-e a termékenység megőrzése a kezelés előtt."
      },
      "whyItMatters": {
        "hu": "AZ IDŐABLAK SZŰK ÉS NEM NYÍLIK ÚJRA: a petesejt- vagy embriófagyasztás a kezelés MEGKEZDÉSE ELŐTT lehetséges. A „nem került szóba” ezért vörös zászló, nem semleges válasz — a fiatal daganatos betegek termékenységi tanácsadásának elmaradása a leggyakrabban felrótt mulasztás."
      }
    }
  },
