    "validity": {
      "labour": "PT4H"
    },
    "documentation": {
      "definition": {
        "hu": "A szülés melyik szakában tart a beteg."
      },
      "whyItMatters": {
        "hu": "A WHO Labour Care Guide szerint az aktív szak 5 cm-től számítandó, nem 4-től — a korábbi küszöb mellett a látens szakban lévő nők jelentős részét „elhúzódónak” minősítették."
      }
    }
  },
  {
    "id": "labour.startedAt",
    "version": 1,
    "status": "active",
    "label": {
      "hu": "Vajúdás kezdete"
    },
    "module": "labour",
    "datatype": "datetime",
    "documentation": {
      "definition": {
        "hu": "Mikor indult meg a vajúdás."
      },
      "pitfalls": {
        "hu": "A BETEG BESZÁMOLÓJA szerinti kezdet és az AKTÍV szak kezdete nem ugyanaz. A partogram az aktív szakot rajzolja; a kettő összekeverése hamis elhúzódást mutat, és fölösleges beavatkozáshoz vezet."
      },
      "whyItMatters": {
        "hu": "A partogram X-tengelyének nullpontja, és minden időalapú küszöb (elhúzódó szak, burokrepedés óta eltelt idő) ehhez mérve értelmezendő."
      }
    }
  },
