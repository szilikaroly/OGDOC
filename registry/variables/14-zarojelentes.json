  {
    "id": "disch.institution.approved",
    "version": 1,
    "status": "active",
    "label": {
      "hu": "Az intézmény befogadta a generált zárójelentést"
    },
    "module": "disch",
    "datatype": "tristate",
    "valueSet": [
      {
        "code": "pos",
        "label_hu": "Igen, a dokumentációs rend része"
      },
      {
        "code": "neg",
        "label_hu": "Nem"
      },
      {
        "code": "unk",
        "label_hu": "Nem ismert",
        "flags": [
          "unknown"
        ]
      }
    ],
    "documentation": {
      "definition": {
        "hu": "Jóváhagyta-e az intézmény a generált zárójelentést, és illesztette-e a saját dokumentációs rendjébe."
      },
      "pitfalls": {
        "hu": "A „nem ismert” NEM jóváhagyás. Jóváhagyás nélkül a dokumentum belső munkaanyag: kinyomtatható, de nem hiteles egészségügyi dokumentum."
      },
      "whyItMatters": {
        "hu": "Ez a modul nyitott kérdésének a mezője. A generálás minősége és a JOGI STÁTUSZ két külön dolog — egy tökéletes tartalmú dokumentum is lehet nem hiteles."
      }
    }
  },
  {
