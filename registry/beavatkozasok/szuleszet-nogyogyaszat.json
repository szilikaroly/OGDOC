    "documentation": {
      "whyItMatters": {
        "hu": "Ugyanaz a beavatkozás, más sürgősségi kategóriával — a döntés–kiemelés idő minőségi mutató."
      },
      "pitfalls": {
        "hu": "A KÓD AZONOS a tervezettel: az OENO nem különbözteti meg a sürgősséget. A megkülönböztetés az `op.pre.urgency` mezőben él, és a minőségi mutatók onnan számolnak — nem a kódból."
      }
    },
    "oeno": {
