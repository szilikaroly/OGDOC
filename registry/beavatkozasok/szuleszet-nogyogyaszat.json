  {
    "id": "proc.cs.elective",
    "label": {
      "hu": "Tervezett császármetszés"
    },
    "synonyms": [
      "elektív sectio",
      "tervezett sectio"
    ],
    "steps": [
      "behatolás",
      "hasüreg megnyitása",
      "uterotomia",
      "a magzat kiemelése",
      "a lepény eltávolítása",
      "a méh zárása",
      "hasfal zárása"
    ],
    "opens": [
      "op.cs.uterotomy",
      "op.cs.prevScar",
      "op.cs.placenta",
      "op.cs.adhesions",
      "op.intra.deliveryAt"
    ],
    "template": "cs",
    "documentation": {
      "whyItMatters": {
        "hu": "A leggyakoribb szülészeti műtét. A sablon azért külön, mert a következő terhesség szempontjából döntő adatokat (uterotomia típusa, heg állapota) csak itt lehet rögzíteni."
      }
    },
    "oeno": {
      "system": "mut",
      "code": "57410",
      "version": "MUT 2026-02",
      "label": {
        "hu": "Császármetszés - cervicalis, transversalis"
      },
      "alternatives": [
        {
          "code": "57400",
          "label": "Császármetszés - corporalis, longitudinalis",
          "when": {
            "hu": "ha a uterotomia testi, hosszanti metszéssel készült"
          }
        },
        {
          "code": "57420",
          "label": "Császármetszés - extraperitonealis",
          "when": {
            "hu": "extraperitonealis behatolás esetén"
          }
        },
        {
          "code": "57421",
          "label": "Császármetszés sterilizálással",
          "when": {
            "hu": "ha egy ülésben sterilizálás is történt"
          }
        }
      ]
    }
  },
  {
